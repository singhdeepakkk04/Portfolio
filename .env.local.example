# Copy to `.env.local` for local development (`npm run dev`).
# `.env.local` is gitignored and must never be committed.
#
# ── Two files, two runtimes ────────────────────────────────────────────────
#
#   .env.local   `next dev` / `next build` on your machine
#   .dev.vars    the Workers runtime locally (`npm run cf:preview`)
#
# Production reads none of these. Cloudflare serves the values as Worker
# secrets: put them in `.dev.vars` and run `npm run cf:secrets` to upload,
# or add them under Settings > Variables and Secrets with Type = Secret.
#
# Add them as *Secret*, never *Variable*: `wrangler deploy` treats
# wrangler.jsonc as the source of truth for plain-text vars and wipes any set
# in the dashboard. Secrets are stored separately and survive deploys.

# ── Supabase ───────────────────────────────────────────────────────────────
# These unprefixed names are what the app reads at runtime. They deliberately
# have no NEXT_PUBLIC_ prefix: Next.js inlines NEXT_PUBLIC_* values into the
# bundle at build time, so a build without credentials bakes in `undefined`
# that no Worker secret can override afterwards.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Admin portal ───────────────────────────────────────────────────────────
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_password_here

# Base32 seed for the authenticator app. Generated during first-time 2FA
# enrolment, which cannot persist it on Workers (no filesystem) -- the login
# route hands you the value and you store it here, then upload it.
#
# Changing this invalidates every existing admin session: the session cookie
# is signed with a key derived from ADMIN_PASSWORD and TOTP_SECRET.
TOTP_SECRET=your_base32_totp_secret

# ── Optional ───────────────────────────────────────────────────────────────
# Google Analytics measurement ID. Client-side, so this one is genuinely
# public and must keep the NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
